@page "/courses"
@rendermode InteractiveServer
@inject CourseService CourseService
@inject NavigationManager Nav
@using BlazorApp1.Models
@using BlazorApp1.Services

<h3>Courses</h3>

<a href="/courses/create" class="btn btn-primary mb-3">+ Add New</a>

@if (courses == null)
{
    <p>Loading...</p>
}
else if (!courses.Any())
{
    <p>No courses found.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category ID</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var course in courses)
            {
                <tr>
                    <td>@course.Title</td>
                    <td>@course.Description</td>
                    <td>@course.Price</td>
                    <td>@course.CategoryId</td>
                    <td>
                        <a href="/courses/edit/@course.Id" class="btn btn-sm btn-warning">Edit</a>
                        <button class="btn btn-sm btn-danger"
                                @onclick="() => ConfirmDelete(course.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showConfirm)
{
    <div class="alert alert-danger mt-3">
        <p>are you sure!!!!!!!!</p>
        <button class="btn btn-danger" @onclick="DeleteConfirmed">نعم، احذف</button>
        <button class="btn btn-secondary ms-2" @onclick="CancelDelete">إلغاء</button>
    </div>
}

@code {
    private List<Course>? courses;
    private bool showConfirm = false;
    private string selectedId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        courses = await CourseService.GetAllAsync();
    }

    private void ConfirmDelete(string id)
    {
        selectedId = id;
        showConfirm = true;
    }

    private void CancelDelete()
    {
        showConfirm = false;
        selectedId = string.Empty;
    }

    private async Task DeleteConfirmed()
    {
        await CourseService.DeleteAsync(selectedId);
        showConfirm = false;
        courses = await CourseService.GetAllAsync();
    }
}